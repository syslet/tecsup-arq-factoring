---
import "../styles/global.css";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Verificación Pendiente | Factoring B2B</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <style>
      body {
        font-family: "Outfit", sans-serif;
        background-color: #0b0b0c;
      }
    </style>
  </head>
  <body class="flex min-h-screen flex-col text-gray-100">
    <header class="border-b border-gray-800 bg-[#0c0c0e]/80 px-6 py-4">
      <div class="mx-auto flex max-w-7xl items-center justify-between">
        <a href="/" class="text-xl font-bold tracking-tight text-emerald-400">Factoring B2B</a>
      </div>
    </header>

    <main
      class="mx-auto flex w-full max-w-xl flex-grow items-center justify-center p-6 text-center"
    >
      <div
        class="rounded-2xl border border-amber-500/30 bg-slate-900/90 p-8 shadow-2xl backdrop-blur-md"
      >
        <div
          class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-amber-500/10 text-amber-400"
        >
          <svg class="h-8 w-8 animate-spin" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"
            ></circle>
            <path
              class="opacity-75"
              fill="currentColor"
              d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
            ></path>
          </svg>
        </div>
        <h1 class="text-2xl font-bold text-white">Verificación en Proceso</h1>
        <p class="mt-2 text-sm text-gray-400">
          Estamos verificando los datos de tu empresa en SUNAT y RENIEC. Este proceso suele demorar
          unos minutos.
        </p>

        <div
          id="company-info-box"
          class="mt-6 space-y-2 rounded-xl border border-gray-800 bg-slate-950 p-4 text-left text-xs text-gray-300"
        >
          <div>
            <strong class="text-gray-400">Estado de Verificación:</strong>
            <span id="status-tag" class="font-bold text-amber-400">PENDING_VERIFICATION</span>
          </div>
          <div>
            <strong class="text-gray-400">Empresa:</strong>
            <span id="comp-name">Cargando...</span>
          </div>
          <div>
            <strong class="text-gray-400">RUC:</strong>
            <span id="comp-ruc">Cargando...</span>
          </div>
        </div>

        <div class="mt-8 flex flex-col gap-3">
          <button
            id="btn-check-status"
            class="w-full rounded-xl border border-gray-800 bg-slate-800 py-3 text-sm font-semibold text-white hover:bg-gray-700"
          >
            Actualizar Estado
          </button>
          <button
            id="btn-mock-approve"
            class="w-full rounded-xl bg-emerald-500 py-3 text-sm font-bold text-black transition-all hover:bg-emerald-400"
          >
            Simular Aprobación Administrativa (Mock SUNAT)
          </button>
        </div>
      </div>
    </main>

    <script>
      import { apiClient } from "../adapters/api_client";

      let companyId: number | null = null;

      async function checkStatus() {
        try {
          const res = await apiClient.get<{ user: any }>("/api/auth/me");
          const user = res.user;
          if (user.company) {
            companyId = user.company.id;
            (document.getElementById("comp-name") as HTMLElement).textContent =
              user.company.business_name;
            (document.getElementById("comp-ruc") as HTMLElement).textContent = user.company.ruc;
          }
          (document.getElementById("status-tag") as HTMLElement).textContent =
            user.verification_status;

          if (user.verification_status === "APPROVED" || user.verification_status === "VERIFIED") {
            window.location.href = "/dashboard";
          }
        } catch (e) {
          console.error(e);
        }
      }

      document.getElementById("btn-check-status")?.addEventListener("click", checkStatus);

      document.getElementById("btn-mock-approve")?.addEventListener("click", async () => {
        if (!companyId) await checkStatus();
        if (companyId) {
          await apiClient.post(`/api/v1/admin/companies/${companyId}/verify`, { approve: true });
          window.location.href = "/dashboard";
        }
      });

      checkStatus();
    </script>
  </body>
</html>
