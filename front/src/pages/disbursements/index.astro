---
import "../../styles/global.css";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Histórico de Desembolsos | Factoring B2B</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <style>
      body {
        font-family: "Outfit", sans-serif;
        background-color: #0b0b0c;
      }
    </style>
  </head>
  <body class="flex min-h-screen flex-col text-gray-100">
    <header class="border-b border-gray-800 bg-[#0c0c0e]/80 px-6 py-4">
      <div class="mx-auto flex max-w-7xl items-center justify-between">
        <a href="/dashboard" class="text-xl font-bold tracking-tight text-emerald-400"
          >&larr; Volver al Dashboard</a
        >
        <span class="text-sm font-semibold text-gray-400">Histórico de Desembolsos y Anotaciones CAVALI</span>
      </div>
    </header>

    <main class="mx-auto w-full max-w-6xl flex-grow p-6">
      <div class="rounded-2xl border border-gray-800 bg-slate-900/90 p-8 shadow-2xl backdrop-blur-md">
        <div class="mb-6 flex items-center justify-between">
          <div>
            <h1 class="text-2xl font-bold text-white">Desembolsos Ejecutados</h1>
            <p class="text-xs text-gray-400">Registro de transferencias bancarias y anotaciones en cuenta CAVALI.</p>
          </div>
          <a
            href="/sales/new"
            class="rounded-xl bg-emerald-500 px-4 py-2.5 text-xs font-bold text-black shadow-lg shadow-emerald-500/20 hover:bg-emerald-400"
          >
            + Nueva Planilla
          </a>
        </div>

        <div
          id="error-box"
          class="mb-4 hidden rounded-lg border border-red-500/30 bg-red-500/10 p-3 text-xs font-medium text-red-400"
        >
        </div>

        <div class="overflow-hidden rounded-xl border border-gray-800 bg-slate-950">
          <table class="w-full text-left text-xs text-gray-300">
            <thead class="border-b border-gray-800 bg-slate-900 font-semibold text-gray-400 uppercase">
              <tr>
                <th class="p-3">Código Anotación</th>
                <th class="p-3">Planilla ID</th>
                <th class="p-3">Monto Desembolsado</th>
                <th class="p-3">Banco / Cuenta / CCI</th>
                <th class="p-3">Fecha Ejecución</th>
                <th class="p-3">Estado</th>
                <th class="p-3 text-center">Acción</th>
              </tr>
            </thead>
            <tbody id="disbursements-tbody" class="divide-y divide-gray-800">
              <tr>
                <td colspan="7" class="p-4 text-center text-gray-500">Cargando historial de desembolsos...</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </main>

    <script>
      import { DisbursementAdapter } from "../../adapters/api/disbursementAdapter";

      const tbody = document.getElementById("disbursements-tbody");
      const errorBox = document.getElementById("error-box");

      async function loadDisbursements() {
        try {
          const res = await DisbursementAdapter.getDisbursementsList();
          const disbursements = res.disbursements || [];

          if (!tbody) return;

          if (disbursements.length === 0) {
            tbody.innerHTML = `
              <tr>
                <td colspan="7" class="p-6 text-center text-gray-500">
                  No se registran desembolsos ejecutados hasta la fecha.
                </td>
              </tr>
            `;
            return;
          }

          tbody.innerHTML = disbursements
            .map(
              (d) => `
            <tr class="hover:bg-slate-900/50">
              <td class="p-3 font-mono font-bold text-emerald-400">${d.annotation_code}</td>
              <td class="p-3 font-semibold text-white">#${d.sheet_id}</td>
              <td class="p-3 font-bold text-white">${d.currency} ${d.amount.toFixed(2)}</td>
              <td class="p-3 text-gray-400">${d.bank_name} - ${d.bank_account_number} (CCI: ${d.cci})</td>
              <td class="p-3">${d.executed_at ? new Date(d.executed_at).toLocaleString('es-PE') : '-'}</td>
              <td class="p-3"><span class="rounded bg-emerald-500/10 px-2.5 py-1 text-[10px] font-bold text-emerald-400">${d.status}</span></td>
              <td class="p-3 text-center">
                <a href="/disbursements/${d.id}" class="rounded bg-slate-800 px-3 py-1 text-xs font-semibold text-emerald-400 hover:bg-slate-700">Ver Comprobante</a>
              </td>
            </tr>
          `
            )
            .join("");
        } catch (err: any) {
          if (errorBox) {
            errorBox.textContent = err.message || "Error al cargar el historial de desembolsos";
            errorBox.classList.remove("hidden");
          }
        }
      }

      loadDisbursements();
    </script>
  </body>
</html>
