---
import "../../styles/global.css";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Panel de Administración - Planillas | Factoring B2B</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <style>
      body {
        font-family: "Outfit", sans-serif;
        background-color: #0b0b0c;
      }
    </style>
  </head>
  <body class="flex min-h-screen flex-col text-gray-100">
    <header class="border-b border-gray-800 bg-[#0c0c0e]/80 px-6 py-4">
      <div class="mx-auto flex max-w-7xl items-center justify-between">
        <span class="text-xl font-bold tracking-tight text-emerald-400">
          Factoring B2B <span
            class="ml-2 rounded-md bg-purple-500/20 px-2 py-0.5 text-xs text-purple-400">ADMIN</span
          >
        </span>
        <div class="flex items-center gap-4">
          <a href="/admin/companies" class="text-xs text-gray-400 hover:text-white"
            >Empresas Pendientes</a
          >
          <button id="btn-logout" class="text-xs text-gray-400 hover:text-white"
            >Cerrar Sesión</button
          >
        </div>
      </div>
    </header>

    <main class="mx-auto w-full max-w-7xl flex-grow p-6">
      <div class="mb-6 flex items-center justify-between">
        <div>
          <h1 class="text-2xl font-bold text-white">Todas las Planillas</h1>
          <p class="text-xs text-gray-400">
            Visibilidad administrativa de cotizaciones, aceptaciones y rechazos de todas las
            empresas
          </p>
        </div>
        <button
          id="btn-refresh"
          class="rounded-xl border border-gray-800 bg-slate-900 px-4 py-2 text-xs font-semibold text-gray-300 hover:bg-gray-800"
        >
          Refrescar Lista
        </button>
      </div>

      <div class="overflow-hidden rounded-xl border border-gray-800 bg-slate-900/60">
        <table class="w-full text-left text-xs text-gray-300">
          <thead
            class="border-b border-gray-800 bg-slate-900 font-semibold text-gray-400 uppercase"
          >
            <tr>
              <th class="p-3">Código</th>
              <th class="p-3">Empresa</th>
              <th class="p-3">RUC</th>
              <th class="p-3">Monto Total</th>
              <th class="p-3">Neto Desembolso</th>
              <th class="p-3">Estado</th>
              <th class="p-3">Fecha</th>
            </tr>
          </thead>
          <tbody id="sheets-tbody">
            <tr><td colspan="7" class="p-8 text-center text-gray-500">Cargando planillas...</td></tr
            >
          </tbody>
        </table>
      </div>
    </main>

    <script>
      import { apiClient } from "../../adapters/api_client";

      interface AdminSheet {
        id: number;
        sheet_code: string;
        business_name: string | null;
        ruc: string | null;
        currency: string;
        total_amount: number;
        net_disbursement: number;
        status: string;
        created_at: string | null;
      }

      const STATUS_STYLES: Record<string, string> = {
        DISBURSED: "bg-emerald-500/10 text-emerald-400 border-emerald-500/20",
        APPROVED: "bg-emerald-500/10 text-emerald-400 border-emerald-500/20",
        REJECTED: "bg-red-500/10 text-red-400 border-red-500/20",
        QUOTED: "bg-blue-500/10 text-blue-400 border-blue-500/20",
        NEGOTIATION_REQUESTED: "bg-amber-500/10 text-amber-400 border-amber-500/20",
        COUNTER_OFFERED: "bg-cyan-500/10 text-cyan-400 border-cyan-500/20",
      };

      async function loadSheets() {
        const tbody = document.getElementById("sheets-tbody");
        if (!tbody) return;

        try {
          const res = await apiClient.get<{ sheets: AdminSheet[] }>("/api/v1/admin/sheets");
          const list = res.sheets || [];

          if (list.length === 0) {
            tbody.innerHTML = `<tr><td colspan="7" class="p-8 text-center text-gray-500">No hay planillas registradas todavía.</td></tr>`;
            return;
          }

          tbody.innerHTML = list
            .map((s) => {
              const statusClass =
                STATUS_STYLES[s.status] || "bg-gray-500/10 text-gray-400 border-gray-500/20";
              return `
              <tr class="border-b border-gray-800 hover:bg-slate-800/50 transition-colors">
                <td class="p-3 font-mono font-bold text-white">${s.sheet_code}</td>
                <td class="p-3">${s.business_name || "N/A"}</td>
                <td class="p-3 font-mono text-cyan-400">${s.ruc || "N/A"}</td>
                <td class="p-3 font-semibold text-white">${s.currency} ${s.total_amount.toFixed(2)}</td>
                <td class="p-3 font-bold text-emerald-400">${s.currency} ${s.net_disbursement.toFixed(2)}</td>
                <td class="p-3">
                  <span class="inline-flex rounded-full border px-2.5 py-0.5 text-xs font-semibold ${statusClass}">${s.status}</span>
                </td>
                <td class="p-3 text-gray-500">${s.created_at ? new Date(s.created_at).toLocaleString("es-PE") : "N/A"}</td>
              </tr>
            `;
            })
            .join("");
        } catch (e) {
          tbody.innerHTML = `<tr><td colspan="7" class="p-4 text-red-400 text-xs">Error al cargar la lista de planillas.</td></tr>`;
        }
      }

      document.getElementById("btn-refresh")?.addEventListener("click", loadSheets);
      document.getElementById("btn-logout")?.addEventListener("click", () => {
        localStorage.removeItem("factoring_access_token");
        window.location.href = "/login";
      });
      loadSheets();
    </script>
  </body>
</html>
