---
import "../styles/global.css";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Registro | Factoring B2B MVP</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <style>
      body {
        font-family: "Outfit", sans-serif;
        background-color: #0b0b0c;
      }
    </style>
  </head>
  <body class="flex min-h-screen flex-col text-gray-100">
    <header class="border-b border-gray-800 bg-[#0c0c0e]/80 px-6 py-4">
      <div class="mx-auto flex max-w-7xl items-center justify-between">
        <a href="/" class="text-xl font-bold tracking-tight text-emerald-400">Factoring B2B</a>
        <a href="/login" class="text-sm font-medium text-gray-400 hover:text-white"
          >Iniciar Sesión</a
        >
      </div>
    </header>

    <main class="mx-auto flex w-full max-w-2xl flex-grow items-center justify-center p-6">
      <div
        class="w-full rounded-2xl border border-gray-800 bg-slate-900/90 p-8 shadow-2xl backdrop-blur-md"
      >
        <!-- Progress Stepper -->
        <div class="mb-8 flex items-center justify-between border-b border-gray-800 pb-4">
          <div class="flex items-center gap-3">
            <span
              id="step1-badge"
              class="flex h-8 w-8 items-center justify-center rounded-full bg-emerald-500 text-sm font-bold text-black"
              >1</span
            >
            <span class="text-sm font-semibold text-gray-200">Representante Legal</span>
          </div>
          <div class="mx-4 h-0.5 flex-1 bg-gray-800"></div>
          <div class="flex items-center gap-3">
            <span
              id="step2-badge"
              class="flex h-8 w-8 items-center justify-center rounded-full bg-gray-800 text-sm font-bold text-gray-400"
              >2</span
            >
            <span class="text-sm font-semibold text-gray-400">Empresa & Adjuntos</span>
          </div>
        </div>

        <div
          id="error-box"
          class="mb-4 hidden rounded-lg border border-red-500/30 bg-red-500/10 p-3 text-xs font-medium text-red-400"
        >
        </div>

        <form id="register-wizard-form" class="space-y-4">
          <!-- Step 1 Fields -->
          <div id="step-1-content" class="space-y-4">
            <h2 class="text-lg font-bold text-white">Paso 1: Datos del Representante Legal</h2>
            <div>
              <label class="block text-xs font-semibold text-gray-400 uppercase"
                >Nombre Completo</label
              >
              <input
                type="text"
                id="full_name"
                required
                class="mt-1 w-full rounded-xl border border-gray-800 bg-slate-950 p-3 text-sm text-white focus:border-emerald-500 focus:outline-none"
                placeholder="Juan Pérez"
              />
              <p id="err-full_name" class="mt-1 hidden text-xs text-red-400"></p>
            </div>
            <div class="grid grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-semibold text-gray-400 uppercase"
                  >Email Corporativo</label
                >
                <input
                  type="email"
                  id="email"
                  required
                  class="mt-1 w-full rounded-xl border border-gray-800 bg-slate-950 p-3 text-sm text-white focus:border-emerald-500 focus:outline-none"
                  placeholder="juan@empresa.com"
                />
                <p id="err-email" class="mt-1 hidden text-xs text-red-400"></p>
              </div>
              <div>
                <label class="block text-xs font-semibold text-gray-400 uppercase">Contraseña</label
                >
                <input
                  type="password"
                  id="password"
                  required
                  class="mt-1 w-full rounded-xl border border-gray-800 bg-slate-950 p-3 text-sm text-white focus:border-emerald-500 focus:outline-none"
                  placeholder="Password123!"
                />
                <p id="err-password" class="mt-1 hidden text-xs text-red-400"></p>
              </div>
            </div>
            <div class="grid grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-semibold text-gray-400 uppercase"
                  >DNI (8 dígitos)</label
                >
                <input
                  type="text"
                  id="dni"
                  maxlength="8"
                  required
                  class="mt-1 w-full rounded-xl border border-gray-800 bg-slate-950 p-3 text-sm text-white focus:border-emerald-500 focus:outline-none"
                  placeholder="12345678"
                />
                <p id="err-dni" class="mt-1 hidden text-xs text-red-400"></p>
              </div>
              <div>
                <label class="block text-xs font-semibold text-gray-400 uppercase">Teléfono</label>
                <input
                  type="text"
                  id="phone"
                  maxlength="9"
                  class="mt-1 w-full rounded-xl border border-gray-800 bg-slate-950 p-3 text-sm text-white focus:border-emerald-500 focus:outline-none"
                  placeholder="999888777"
                />
                <p id="err-phone" class="mt-1 hidden text-xs text-red-400"></p>
              </div>
            </div>
            <button
              type="button"
              id="btn-next-step"
              class="w-full rounded-xl bg-emerald-500 py-3 text-sm font-bold text-black transition-all hover:bg-emerald-400"
            >
              Continuar a Datos de Empresa &rarr;
            </button>
          </div>

          <!-- Step 2 Fields -->
          <div id="step-2-content" class="hidden space-y-4">
            <h2 class="text-lg font-bold text-white">
              Paso 2: Datos de la Empresa (Girador) & Adjuntos
            </h2>
            <div class="grid grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-semibold text-gray-400 uppercase"
                  >RUC (11 dígitos)</label
                >
                <input
                  type="text"
                  id="ruc"
                  maxlength="11"
                  required
                  class="mt-1 w-full rounded-xl border border-gray-800 bg-slate-950 p-3 text-sm text-white focus:border-emerald-500 focus:outline-none"
                  placeholder="20123456789"
                />
                <p id="err-ruc" class="mt-1 hidden text-xs text-red-400"></p>
              </div>
              <div>
                <label class="block text-xs font-semibold text-gray-400 uppercase"
                  >Razón Social</label
                >
                <input
                  type="text"
                  id="business_name"
                  required
                  class="mt-1 w-full rounded-xl border border-gray-800 bg-slate-950 p-3 text-sm text-white focus:border-emerald-500 focus:outline-none"
                  placeholder="Empresa S.A.C."
                />
                <p id="err-business_name" class="mt-1 hidden text-xs text-red-400"></p>
              </div>
            </div>
            <div class="grid grid-cols-3 gap-3">
              <div>
                <label class="block text-xs font-semibold text-gray-400 uppercase">Banco</label>
                <input
                  type="text"
                  id="bank_name"
                  required
                  class="mt-1 w-full rounded-xl border border-gray-800 bg-slate-950 p-3 text-sm text-white focus:border-emerald-500 focus:outline-none"
                  placeholder="BCP"
                />
              </div>
              <div>
                <label class="block text-xs font-semibold text-gray-400 uppercase"
                  >N° Cuenta Bancaria</label
                >
                <input
                  type="text"
                  id="bank_account_number"
                  required
                  class="mt-1 w-full rounded-xl border border-gray-800 bg-slate-950 p-3 text-sm text-white focus:border-emerald-500 focus:outline-none"
                  placeholder="193-123456"
                />
              </div>
              <div>
                <label class="block text-xs font-semibold text-gray-400 uppercase"
                  >CCI (20 dígitos)</label
                >
                <input
                  type="text"
                  id="cci"
                  maxlength="20"
                  required
                  class="mt-1 w-full rounded-xl border border-gray-800 bg-slate-950 p-3 text-sm text-white focus:border-emerald-500 focus:outline-none"
                  placeholder="00219300123456780123"
                />
                <p id="err-cci" class="mt-1 hidden text-xs text-red-400"></p>
              </div>
            </div>
            <div>
              <label class="block text-xs font-semibold text-gray-400 uppercase"
                >Adjuntar Ficha RUC / Vigencia Poder (PDF/Imagen)</label
              >
              <input
                type="file"
                id="document_file"
                accept=".pdf,.jpg,.jpeg,.png"
                required
                class="mt-1 w-full rounded-xl border border-gray-800 bg-slate-950 p-2 text-xs text-gray-400"
              />
              <p id="err-document_file" class="mt-1 hidden text-xs text-red-400"></p>
            </div>

            <div class="flex gap-3 pt-2">
              <button
                type="button"
                id="btn-back-step"
                class="w-1/3 rounded-xl border border-gray-800 bg-slate-950 py-3 text-sm font-semibold text-gray-300 hover:bg-gray-800"
              >
                &larr; Volver
              </button>
              <button
                type="submit"
                id="btn-submit-register"
                class="w-2/3 rounded-xl bg-emerald-500 py-3 text-sm font-bold text-black transition-all hover:bg-emerald-400"
              >
                Completar Registro & Solicitar Verificación
              </button>
            </div>
          </div>
        </form>
      </div>
    </main>

    <script>
      import { apiClient } from "../adapters/api_client";
      import { tokenStorage } from "../adapters/storage/token-storage";

      const step1Content = document.getElementById("step-1-content");
      const step2Content = document.getElementById("step-2-content");
      const step1Badge = document.getElementById("step1-badge");
      const step2Badge = document.getElementById("step2-badge");
      const errorBox = document.getElementById("error-box");

      function field(id: string): HTMLInputElement {
        return document.getElementById(id) as HTMLInputElement;
      }

      function showError(id: string, message: string | null): void {
        const el = document.getElementById(`err-${id}`);
        if (!el) return;
        if (message) {
          el.textContent = message;
          el.classList.remove("hidden");
        } else {
          el.classList.add("hidden");
        }
      }

      const FREE_EMAIL_DOMAINS = [
        "gmail.com",
        "hotmail.com",
        "yahoo.com",
        "outlook.com",
        "live.com",
      ];

      const validators: Record<string, () => string | null> = {
        full_name: () =>
          field("full_name").value.trim().length < 2 ? "Ingrese un nombre completo válido." : null,
        email: () => {
          const value = field("email").value.trim().toLowerCase();
          const parts = value.split("@");
          if (!value.includes("@") || parts.length !== 2)
            return "Ingrese un correo electrónico válido.";
          if (FREE_EMAIL_DOMAINS.includes(parts[1]))
            return "Use un correo corporativo (no Gmail, Hotmail, Yahoo, etc.).";
          return null;
        },
        password: () => {
          const value = field("password").value;
          if (!/^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@$!%*?&._-]).{8,}$/.test(value)) {
            return "Mínimo 8 caracteres, con mayúscula, minúscula, número y carácter especial (@$!%*?&._-).";
          }
          return null;
        },
        dni: () =>
          !/^\d{8}$/.test(field("dni").value) ? "El DNI debe tener exactamente 8 dígitos." : null,
        phone: () => {
          const value = field("phone").value.trim();
          if (!value) return null;
          return !/^9\d{8}$/.test(value)
            ? "El celular debe tener 9 dígitos y empezar con 9."
            : null;
        },
        ruc: () =>
          !/^(10|15|17|20)\d{9}$/.test(field("ruc").value)
            ? "El RUC debe tener 11 dígitos y empezar con 10, 15, 17 o 20."
            : null,
        business_name: () =>
          field("business_name").value.trim().length < 3
            ? "La Razón Social debe tener al menos 3 caracteres."
            : null,
        cci: () =>
          !/^\d{20}$/.test(field("cci").value) ? "El CCI debe tener exactamente 20 dígitos." : null,
        document_file: () => {
          const files = field("document_file").files;
          return !files || files.length === 0 ? "Adjunte la Ficha RUC o Vigencia de Poder." : null;
        },
      };

      function validateField(id: string): boolean {
        const message = validators[id]();
        showError(id, message);
        return message === null;
      }

      for (const id of Object.keys(validators)) {
        const input = field(id);
        input?.addEventListener(id === "document_file" ? "change" : "input", () =>
          validateField(id)
        );
        input?.addEventListener("blur", () => validateField(id));
      }

      document.getElementById("dni")?.addEventListener("input", (e) => {
        (e.target as HTMLInputElement).value = (e.target as HTMLInputElement).value.replace(
          /\D/g,
          ""
        );
      });
      document.getElementById("ruc")?.addEventListener("input", (e) => {
        (e.target as HTMLInputElement).value = (e.target as HTMLInputElement).value.replace(
          /\D/g,
          ""
        );
      });
      document.getElementById("cci")?.addEventListener("input", (e) => {
        (e.target as HTMLInputElement).value = (e.target as HTMLInputElement).value.replace(
          /\D/g,
          ""
        );
      });
      document.getElementById("phone")?.addEventListener("input", (e) => {
        (e.target as HTMLInputElement).value = (e.target as HTMLInputElement).value.replace(
          /\D/g,
          ""
        );
      });

      document.getElementById("btn-next-step")?.addEventListener("click", () => {
        const step1Fields = ["full_name", "email", "password", "dni", "phone"];
        const allValid = step1Fields.map(validateField).every(Boolean);

        if (!allValid) {
          if (errorBox) {
            errorBox.textContent = "Corrija los campos marcados en rojo antes de continuar.";
            errorBox.classList.remove("hidden");
          }
          return;
        }
        errorBox?.classList.add("hidden");
        step1Content?.classList.add("hidden");
        step2Content?.classList.remove("hidden");
        step2Badge?.classList.remove("bg-gray-800", "text-gray-400");
        step2Badge?.classList.add("bg-emerald-500", "text-black");
      });

      document.getElementById("btn-back-step")?.addEventListener("click", () => {
        step2Content?.classList.add("hidden");
        step1Content?.classList.remove("hidden");
      });

      document.getElementById("register-wizard-form")?.addEventListener("submit", async (e) => {
        e.preventDefault();

        const step2Fields = ["ruc", "business_name", "cci", "document_file"];
        const allValid = step2Fields.map(validateField).every(Boolean);
        if (!allValid) {
          if (errorBox) {
            errorBox.textContent = "Corrija los campos marcados en rojo antes de continuar.";
            errorBox.classList.remove("hidden");
          }
          return;
        }

        try {
          const payload = {
            email: field("email").value.trim(),
            password: field("password").value,
            full_name: field("full_name").value.trim(),
            dni: field("dni").value,
            phone: field("phone").value.trim() || null,
            company: {
              ruc: field("ruc").value,
              business_name: field("business_name").value.trim(),
              bank_name: field("bank_name").value.trim(),
              bank_account_number: field("bank_account_number").value.trim(),
              cci: field("cci").value,
              currency: "PEN",
            },
          };

          await apiClient.post<{ message: string; user: any }>("/api/auth/register", payload);

          // Auto-login to obtain JWT token
          const loginRes = await apiClient.post<{ access_token: string }>("/api/auth/login", {
            identifier: payload.email,
            password: payload.password,
          });
          tokenStorage.setToken(loginRes.access_token);

          // Upload the actual selected document file
          const selectedFile = field("document_file").files?.[0];
          if (selectedFile) {
            const formData = new FormData();
            formData.append("document_type", "RUC_FICHA");
            formData.append("file", selectedFile);
            await apiClient.postForm("/api/v1/onboarding/documents", formData);
          }

          window.location.href = "/verification-pending";
        } catch (err: any) {
          if (errorBox) {
            errorBox.textContent = err.message || "Error al completar el registro";
            errorBox.classList.remove("hidden");
          }
        }
      });
    </script>
  </body>
</html>
