---
import "../styles/global.css";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Antigravity Project - Layout Inicial</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <style>
      body {
        font-family: "Outfit", sans-serif;
        background-color: #0b0b0c;
        background-image:
          radial-gradient(at 0% 0%, rgba(16, 185, 129, 0.05) 0px, transparent 50%),
          radial-gradient(at 100% 100%, rgba(59, 130, 246, 0.05) 0px, transparent 50%);
      }
    </style>
  </head>
  <body class="flex min-h-screen flex-col text-gray-100">
    <!-- Header -->
    <header class="sticky top-0 z-50 border-b border-gray-800 bg-[#0c0c0e]/80 backdrop-blur-md">
      <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
        <div class="flex items-center gap-3">
          <div
            class="flex h-8 w-8 items-center justify-center rounded-lg bg-gradient-to-tr from-emerald-500 to-blue-600 text-sm font-bold text-black"
          >
            AG
          </div>
          <div>
            <h1 class="text-base leading-none font-bold tracking-tight text-white">
              Antigravity Workspace
            </h1>
            <span class="text-[10px] font-semibold tracking-widest text-gray-500 uppercase"
              >Core Template</span
            >
          </div>
        </div>
        <nav class="flex items-center gap-6 text-sm">
          <a href="#" class="font-medium text-emerald-400">Home</a>
          <a href="../../../CLAUDE.md" class="text-gray-400 transition-colors hover:text-white"
            >CLAUDE.md</a
          >
          <a
            href="../../../.localbrain/code_practices/index.md"
            class="text-gray-400 transition-colors hover:text-white">Prácticas de Código</a
          >
        </nav>
      </div>
    </header>

    <!-- Main Content -->
    <main
      class="mx-auto flex w-full max-w-7xl flex-grow items-center justify-center px-4 py-10 sm:px-6 lg:px-8"
    >
      <div class="mx-auto max-w-3xl text-center">
        <div
          class="mb-6 inline-flex items-center gap-2 rounded-full border border-emerald-500/20 bg-emerald-500/10 px-3 py-1 text-xs font-medium text-emerald-400"
        >
          <span class="h-2 w-2 animate-pulse rounded-full bg-emerald-400"></span>
          Astro + Flask + Docker Compose
        </div>
        <h2
          class="mb-6 bg-gradient-to-r from-white via-gray-100 to-gray-500 bg-clip-text text-5xl font-extrabold tracking-tight text-transparent text-white sm:text-6xl"
        >
          Workspace Inicializado
        </h2>
        <p class="mx-auto mb-8 max-w-xl text-base text-gray-400">
          Layout inicial del monorepo configurado con Onion Architecture en el backend y Clean
          Architecture desacoplada en el frontend. Calidad de código forzada mediante pre-commit.
        </p>

        <div class="flex items-center justify-center gap-4">
          <div
            class="min-w-[200px] rounded-xl border border-gray-800/80 bg-[#121214]/40 px-6 py-4 text-left"
          >
            <div class="mb-1 text-sm font-semibold text-emerald-400">Backend</div>
            <p class="text-xs text-gray-500">Flask + Python 3.11 + uv</p>
          </div>
          <div
            class="min-w-[200px] rounded-xl border border-gray-800/80 bg-[#121214]/40 px-6 py-4 text-left"
          >
            <div class="mb-1 text-sm font-semibold text-emerald-400">Frontend</div>
            <p class="text-xs text-gray-500">Astro + Tailwind + React</p>
          </div>
        </div>
      </div>
    </main>

    <!-- Footer -->
    <footer class="border-t border-gray-900 bg-[#08080a] py-6">
      <div
        class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-4 px-4 text-xs text-gray-600 sm:flex-row sm:px-6 lg:px-8"
      >
        <p>&copy; 2026 Antigravity Core. Template base configurado.</p>
        <p>Backend: Flask/uv | Frontend: Astro/React/Tailwind | DB: Postgres</p>
      </div>
    </footer>
  </body>
</html>
